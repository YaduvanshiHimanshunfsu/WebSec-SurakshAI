{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://websec-surakshai-api.onrender.com/api/$1"
    },
    {
      "source": "/passive/(.*)",
      "destination": "https://websec-surakshai-api.onrender.com/passive/$1"
    },
    {
      "source": "/active/(.*)",
      "destination": "https://websec-surakshai-api.onrender.com/active/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
