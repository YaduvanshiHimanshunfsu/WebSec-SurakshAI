# ─── Environment ────────────────────────────────────────────────
SECRET_KEY=generate-a-long-random-string-here-min-32-chars
DATABASE_URL=sqlite:///websec.db

# ─── Admin Access (no full user system in v1) ───────────────────
# Set a strong password — this gates the entire dashboard
ADMIN_PASSWORD=change_this_before_deploying

# ─── External APIs ──────────────────────────────────────────────
# Google Safe Browsing API (free)
# Get key at: https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# PhishTank API (free)
# Register at: https://www.phishtank.com/api_register.php
PHISHTANK_API_KEY=your_phishtank_api_key_here

# ─── AI Analyzer (Google Gemini) ────────────────────────────────
# Powers the scam detection, email analysis, and AI Remediation features.
# Get your FREE key at: https://aistudio.google.com/
# Without this key, rule-based fallback analysis will be used automatically.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── Production Only ────────────────────────────────────────────
# FLASK_ENV=production
# DATABASE_URL=postgresql://user:password@host:5432/websec_db
